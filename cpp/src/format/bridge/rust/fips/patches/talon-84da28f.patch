+#[cfg(feature = "fips")]
+pub(crate) fn ensure_fips_provider() -> Result<(), &'static str> {
+    use rustls::crypto::CryptoProvider;
+
+    if CryptoProvider::get_default().is_none() {
+        let provider = rustls::crypto::default_fips_provider();
+        if !provider.fips() {
+            return Err("AWS-LC FIPS provider is unavailable");
+        }
+        let _ = provider.install_default();
+    }
+    if CryptoProvider::get_default().is_some_and(|provider| provider.fips()) {
+        Ok(())
+    } else {
+        Err("process Rustls provider must support FIPS")
+    }
+}
+
