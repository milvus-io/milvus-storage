+    let builder = reqwest::Client::builder();
+    #[cfg(feature = "fips")]
+    let builder = {
+        ensure_fips_provider()?;
+        // Cargo feature unification can also enable reqwest's native-TLS backend.
+        builder.use_rustls_tls()
+    };
+    Ok(builder)
+}
